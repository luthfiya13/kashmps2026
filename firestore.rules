rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      let adminEmails = ["zuhurasf1311@gmail.com", "admin2@gmail.com", "admin3@gmail.com"];
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email in adminEmails);
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true; // Mahasiswa bisa cari data mereka sendiri
      allow write: if isAdmin();
    }

    // Requests collection
    match /requests/{requestId} {
      allow read: if true;
      allow create: if true; // Siapapun bisa kirim request bayar
      allow update, delete: if isAdmin();
    }
    
    // Users collection for roles
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
